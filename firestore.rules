rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Accounts are provisioned by the owner. Every signed-in user is an admin.
    // This covers every document, including nested and future collections.
    match /{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
